{
  "name": "gentouch-ministry-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GenTouch Ministry System — Generation Touch Harvest International",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/server/db/scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx src/server/db/scripts/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:seed:demo": "node --env-file-if-exists=.env --import tsx src/server/db/scripts/seed-demo.ts",
    "db:check": "node --env-file-if-exists=.env --import tsx src/server/db/scripts/integrity-check.ts",
    "db:seed:load": "node --env-file-if-exists=.env --import tsx src/server/db/scripts/seed-load.ts",
    "db:explain": "node --env-file-if-exists=.env --import tsx src/server/db/scripts/explain-check.ts",
    "db:load-keys": "node --env-file-if-exists=.env --import tsx src/server/db/scripts/load-keys.ts",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-slot": "^1.3.3",
    "@sentry/nextjs": "^10.74.0",
    "@tanstack/react-table": "^9.2.4",
    "@upstash/ratelimit": "^2.1.0",
    "@upstash/redis": "^1.38.4",
    "better-auth": "^1.7.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "libphonenumber-js": "^1.13.13",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "otpauth": "^9.5.2",
    "papaparse": "^5.7.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.88.0",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "fast-check": "^4.10.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vitest": "^5.0.0"
  }
}
