# ─── GenTouch Ministry System — environment variables ───────────────────────────
# Copy to `.env` for local development. Never commit real secrets.
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# Public base URL (used in magic links, QR codes and personal links)
APP_URL=http://localhost:3000

# ─── Database ───────────────────────────────────────────────────────────────────
# Local development without installing PostgreSQL:  pglite://./.data/pglite
# Supabase (Singapore), from Project Settings → Database → Connect:
#   DATABASE_URL           transaction pooler (port 6543), as a login role that is a member of
#                          gentouch_app (drizzle/0007_row_level_security.sql) or as postgres
#   DATABASE_URL_MIGRATOR  session pooler (port 5432) or direct connection, as postgres
DATABASE_URL=pglite://./.data/pglite
# Optional: a separate role with DDL rights for migrations. Defaults to DATABASE_URL.
DATABASE_URL_MIGRATOR=

# ─── Authentication (Better Auth, until the move to Supabase Auth) ──────────────
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Root key for app encryption and signing (two-step secrets, form sessions, rate-limit keys).
# Empty = BETTER_AUTH_SECRET is used. Before moving to Supabase Auth, set this to the current
# BETTER_AUTH_SECRET value so existing encrypted data stays readable.
APP_ENCRYPTION_KEY=

# ─── Email ──────────────────────────────────────────────────────────────────────
#   console  prints messages, including magic links, to the server log (development)
#   file     writes each message as JSON into EMAIL_OUTBOX_DIR (end-to-end tests)
#   resend   sends through Resend (staging and production)
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM="GenTouch <no-reply@example.org>"
EMAIL_OUTBOX_DIR=.data/outbox

# First Super Admin created by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@gentouch.local
SEED_ADMIN_FIRST_NAME=Ministry
SEED_ADMIN_LAST_NAME=Administrator

# ─── Rate limiting on public pages ──────────────────────────────────────────────
#   postgres  counters in the database (development, tests, a single server)
#   upstash   Upstash Redis (production on Vercel, shared by every server instance)
RATE_LIMIT_STORE=postgres
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Journal proof photos ───────────────────────────────────────────────────────
# Where members' photos of their written journals are kept. Never a public bucket.
#   local     a directory on this machine (development and tests)
#   supabase  a PRIVATE Supabase Storage bucket (production)
STORAGE_DRIVER=local
STORAGE_BUCKET=journal-proofs
STORAGE_DIR=.data/uploads
# Required only for STORAGE_DRIVER=supabase. The service-role key is server-only:
# never copy it into a NEXT_PUBLIC_ variable — it can read and write every bucket.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Error tracking (Sentry) ────────────────────────────────────────────────────
# Leave empty and unexpected errors are only logged.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Source map upload during the build (CI and Vercel only)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ─── Background jobs ────────────────────────────────────────────────────────────
# Closing journal days, prayer slot generation, email delivery, cleanup.
#   in_process  a timer inside the web server runs due jobs every minute
#               (development, and hosting with one long-running server)
#   external    Supabase Cron calls POST /api/cron/tick every minute with the header
#               "Authorization: Bearer <CRON_SECRET>" (Vercel; see deploy/supabase-cron.sql)
#   off         no background jobs (not recommended)
SCHEDULER_MODE=in_process
# Required only for SCHEDULER_MODE=external.
CRON_SECRET=
