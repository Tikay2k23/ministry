# ─── GenTouch Ministry System — environment variables ───────────────────────────
# Copy to `.env` for local development. Never commit real secrets.

# Public base URL (used in magic links and QR codes)
APP_URL=http://localhost:3000

# Database
#   Local development without installing PostgreSQL:  pglite://./.data/pglite
#   Real PostgreSQL (staging/production):              postgres://app_rw:PASSWORD@HOST:5432/gentouch
DATABASE_URL=pglite://./.data/pglite
# Optional: a separate role with DDL rights for migrations. Defaults to DATABASE_URL.
DATABASE_URL_MIGRATOR=

# Authentication (Better Auth)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Email: `console` prints magic links to the server log (development only)
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM="GenTouch <no-reply@example.org>"

# First Super Admin created by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@gentouch.local
SEED_ADMIN_FIRST_NAME=Ministry
SEED_ADMIN_LAST_NAME=Administrator

# Optional error tracking
SENTRY_DSN=

# Background jobs: prayer reminders, overdue prayer slots, closing journal days, email delivery
#   in_process  a timer inside the web server runs due jobs every minute
#               (development, and hosting with one long-running server)
#   external    an outside scheduler calls POST /api/cron/tick every 1–5 minutes with the header
#               "Authorization: Bearer <CRON_SECRET>" (serverless or multi-instance hosting)
#   off         no background jobs (not recommended)
SCHEDULER_MODE=in_process
# Required only for SCHEDULER_MODE=external. Generate like BETTER_AUTH_SECRET.
CRON_SECRET=
